#!/usr/bin/env bash
# skill-hub: Search global skills via trifecta with lightweight alias-aware reranking
# Usage: skill-hub "query"
# Example: skill-hub "refactor"

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TRIFECTA_ROOT="$(dirname "$SCRIPT_DIR")"
CARDS_HELPER="$SCRIPT_DIR/skill-hub-cards"

has_cards_flag() {
    local arg
    for arg in "$@"; do
        if [ "$arg" = "--cards" ]; then
            return 0
        fi
    done
    return 1
}

extract_query_hint() {
    local skip_next=0
    local arg
    for arg in "$@"; do
        if [ "$skip_next" -eq 1 ]; then
            skip_next=0
            continue
        fi
        case "$arg" in
            --limit|-l|--segment|--style)
                skip_next=1
                continue
                ;;
            --json|--stdin-search-output)
                continue
                ;;
            -*)
                continue
                ;;
            *)
                printf '%s' "$arg"
                return 0
                ;;
        esac
    done
    printf ''
}

emit_intro() {
    local query_hint="${1:-}"
    if ! python3 - "$SCRIPT_DIR" "$query_hint" <<'PY'; then
import os
import sys

script_dir = sys.argv[1]
query_hint = sys.argv[2] if len(sys.argv) > 2 else None
sys.path.insert(0, script_dir)
cwd_scripts = os.path.join(os.getcwd(), "scripts")
if cwd_scripts not in sys.path:
    sys.path.insert(0, cwd_scripts)

from skill_hub_runtime_ux import emit_intro

emit_intro(query_hint=query_hint)
PY
        return 1
    fi
}

emit_error_card() {
    local error_code="$1"
    local error_class="$2"
    local cause="$3"
    shift 3
    local verify_cmd="$1"
    shift
    python3 - "$SCRIPT_DIR" "$error_code" "$error_class" "$cause" "$verify_cmd" "$@" <<'PY'
import os
import sys

script_dir = sys.argv[1]
error_code = sys.argv[2]
error_class = sys.argv[3]
cause = sys.argv[4]
verify_cmd = sys.argv[5]
steps = sys.argv[6:] or ["Retry with a valid sentence query."]

sys.path.insert(0, script_dir)
cwd_scripts = os.path.join(os.getcwd(), "scripts")
if cwd_scripts not in sys.path:
    sys.path.insert(0, cwd_scripts)
from skill_hub_runtime_ux import emit_error_card

emit_error_card(
    error_code=error_code,
    error_class=error_class,
    cause=cause,
    next_steps=steps,
    verify_cmd=verify_cmd,
)
PY
}

# Handle help flags before processing query
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat << 'EOF'
Usage: skill-hub [OPTIONS] "query"

Search for skills in the global skills hub using natural language queries.

Options:
  -h, --help    Show this help message and exit

Arguments:
  query         Natural language description of what you need
                (e.g., "refactor", "testing", "debug workflow")

Examples:
  skill-hub "refactor"
  skill-hub "how to implement TDD"
  skill-hub "docker best practices"

Environment Variables:
  SKILL_HUB_RERANK    Reranking mode: auto (default), always, never

Note:
  Multi-word queries may show a "Canonical alias match:" block
  before the normal results for better skill discovery.
EOF
    exit 0
fi

if has_cards_flag "$@"; then
    filtered_args=()
    for arg in "$@"; do
        if [ "$arg" = "--cards" ]; then
            continue
        fi
        filtered_args+=("$arg")
    done

    QUERY_HINT="$(extract_query_hint "${filtered_args[@]}")"
    if [ -z "$QUERY_HINT" ]; then
        emit_error_card \
            "SKILL_HUB_EMPTY_QUERY" \
            "validation" \
            "query required in --cards mode" \
            "skill-hub --cards \"help me with testing strategy\" --limit 1" \
            "Provide a non-empty sentence query."
        exit 1
    fi

    emit_intro "$QUERY_HINT"
    set +e
    python3 "$CARDS_HELPER" "${filtered_args[@]}"
    status=$?
    set -e
    exit "$status"
fi

QUERY="$*"
SEGMENT="${SKILL_HUB_SEGMENT:-$HOME/.trifecta/segments/skills-hub}"

if [ -z "$QUERY" ]; then
    emit_error_card \
        "SKILL_HUB_EMPTY_QUERY" \
        "validation" \
        "query required" \
        "skill-hub \"help me with refactoring\"" \
        "Pass a non-empty sentence query."
    exit 1
fi

emit_intro "$QUERY"

cd "$TRIFECTA_ROOT"

run_search_capture() {
    local output status
    set +e
    output="$(TRIFECTA_LINT=1 uv run trifecta ctx search --segment "$SEGMENT" "$@" 2>&1)"
    status=$?
    set -e
    printf '%s' "$output"
    return "$status"
}

RERANK_MODE="${SKILL_HUB_RERANK:-auto}"
SHOULD_RERANK=0
case "$RERANK_MODE" in
  1|true|always)
    SHOULD_RERANK=1
    ;;
  0|false|never)
    SHOULD_RERANK=0
    ;;
  *)
    if [[ "$QUERY" == *" "* ]]; then
      SHOULD_RERANK=1
    fi
    ;;
esac

EXPLAIN_JSON=""
CANONICAL_ALIAS_MATCH=""
if [ "$SHOULD_RERANK" -eq 1 ] && EXPLAIN_JSON="$(TRIFECTA_LINT=1 uv run trifecta ctx search --segment "$SEGMENT" --query "$QUERY" --limit 20 --explain --explain-format json 2>/dev/null)"; then
    CANONICAL_ALIAS_MATCH="$(EXPLAIN_JSON="$EXPLAIN_JSON" python3 - <<'PY'
import json
import os
import re

try:
    data = json.loads(os.environ.get("EXPLAIN_JSON", ""))
except json.JSONDecodeError:
    print("")
    raise SystemExit(0)

expanded_terms = data.get("expansions", {}).get("expanded_terms", [])
hits = data.get("hits", [])
if not hits:
    print("")
    raise SystemExit(0)

top_ref = hits[0].get("ref", "")
for term in expanded_terms:
    if not re.fullmatch(r"[a-z0-9-]+", term):
        continue
    repo_prefix = f"repo:{term}.md:"
    for hit in hits:
        ref = hit.get("ref", "")
        if ref.startswith(repo_prefix):
            if ref != top_ref:
                print(term)
            else:
                print("")
            raise SystemExit(0)

print("")
PY
)"
fi

if [ "$SHOULD_RERANK" -eq 1 ] && [ -n "$CANONICAL_ALIAS_MATCH" ]; then
    echo "Canonical alias match: $CANONICAL_ALIAS_MATCH"
    ALIAS_OUTPUT="$(run_search_capture --query "$CANONICAL_ALIAS_MATCH" --limit 1)"
    printf '%s\n' "$ALIAS_OUTPUT"
    echo
    echo "Additional results for: $QUERY"
fi

MAIN_OUTPUT="$(run_search_capture --query "$QUERY")"
printf '%s\n' "$MAIN_OUTPUT"
